{
  "name": "nexo-servicio-integral",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "overrides": {
    "sequelize@6.37.8": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
