NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
# Activa en producción final para exigir R2 y SMTP al iniciar.
STRICT_INTEGRATIONS=false

# MySQL local o DATABASE_URL de Railway
DATABASE_URL=mysql://root:password@localhost:3306/nexo_servicios
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexo_servicios
DB_USER=root
DB_PASSWORD=password

JWT_ACCESS_SECRET=cambia-esta-clave-access-de-minimo-32-caracteres
JWT_REFRESH_SECRET=cambia-esta-clave-refresh-de-minimo-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexo-servicios
# Opcional, solo para limpiar URLs antiguas. Los archivos nuevos se mantienen privados.
R2_PUBLIC_URL=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexo Servicio Integral <notificaciones@tu-dominio.com>"
CONTACT_EMAIL=contacto@tu-dominio.com

# Identidad en reportes PDF
COMPANY_NAME=NEXO
COMPANY_SUBTITLE=SERVICIO INTEGRAL
COMPANY_PHONE=55 8000 2468
COMPANY_EMAIL=contacto@nexo.mx

# Seed de demostración (cambiar en producción)
SEED_ADMIN_EMAIL=admin@sealshvac.ca
SEED_ADMIN_PASSWORD=SealsAdmin2026!
SEED_CLIENT_EMAIL=client@sealshvac.ca
SEED_CLIENT_PASSWORD=SealsClient2026!
ALLOW_DEMO_SEED=false
